@inherits LayoutComponentBase
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/admin">
            <span class="logo">Q</span>
            <span><b>Quizly</b><small>Administrace</small></span>
        </a>
        <nav aria-label="Administrace">
            <NavLink href="/admin" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 11L12 4l8.5 7" /><path d="M6 9.5V20h12V9.5" /></svg>Přehled
            </NavLink>
            <NavLink href="/admin/balicky">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="13" height="15" rx="2" /><path d="M8 3h10a2 2 0 0 1 2 2v12" /></svg>Balíčky
            </NavLink>
            <NavLink href="/admin/obchod">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="8" width="17" height="4.5" rx="1" /><path d="M5 12.5V20h14v-7.5" /><path d="M12 8v12" /><path d="M12 8C10.5 4.5 6.5 4 6.5 6.5 6.5 8 9 8 12 8zM12 8c1.5-3.5 5.5-4 5.5-1.5C17.5 8 15 8 12 8z" /></svg>Obchod
                @if (_pending > 0)
                {
                    <span class="badge" title="Čeká na schválení">@_pending</span>
                }
            </NavLink>
            <NavLink href="/admin/uzivatele">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a6.5 6.5 0 0 1 3.5 6" /></svg>Uživatelé
            </NavLink>
            <NavLink href="/admin/texty-upozorneni">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z" /><path d="M10 20.5a2 2 0 0 0 4 0" /></svg>Texty upozornění
            </NavLink>
        </nav>
        <form class="side-foot" method="post" action="/admin/logout" data-enhance="false">
            <AntiforgeryToken />
            <span>
                <AuthorizeView>@context.User.Identity?.Name</AuthorizeView>
            </span>
            <button type="submit">Odhlásit</button>
        </form>
    </aside>
    <main class="main">
        <div class="wrap">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Něco se pokazilo. <a href="" class="reload">Načíst znovu</a>
</div>

@code {
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshPendingAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshPendingAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPendingAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var claims = scope.ServiceProvider.GetRequiredService<Quizly.Application.Shop.IClaimAdminService>();
        _pending = (await claims.ListAsync(ClaimStatus.Pending, CancellationToken.None)).Count;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
