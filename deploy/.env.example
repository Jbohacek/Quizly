# Copy to .env (local) or paste into the Portainer stack's environment variables.
# Never commit the real values.

# Image tag to run (a commit SHA from GHCR, or latest)
QUIZLY_TAG=latest
# Host port that Nginx Proxy Manager forwards to
QUIZLY_PORT=8080

POSTGRES_DB=quizly
POSTGRES_USER=quizly
POSTGRES_PASSWORD=change-me-long-random

# Must match the three values above; the host is the compose service name.
ConnectionStrings__Default=Host=db;Port=5432;Database=quizly;Username=quizly;Password=change-me-long-random

# At least 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SigningKey=change-me-at-least-32-random-bytes-0000000000
Jwt__Issuer=https://quizly.jbohacek.cz

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-random

PUBLIC_BASE_URL=https://quizly.jbohacek.cz
